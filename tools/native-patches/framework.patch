+# NatureLoader native audit: these three boot-installed vector bodies were
+# compared byte-for-byte with RAM at the first fail-before-interpreter stop.
+# The 0x80 exception vector differs at runtime and is deliberately not added.
+[[recompiler.address_model.copy]]
+name         = "Boot A0 vector"
+rom_lo       = "0x1FC06960"
+rom_hi       = "0x1FC06970"
+ram_lo       = "0x000000A0"
+runtime_base = "0x000000A0"
+dispatch_key = "rom"
+kernel_bless = false
+
+[[recompiler.address_model.copy]]
+name         = "Boot B0 vector"
+rom_lo       = "0x1FC06970"
+rom_hi       = "0x1FC06980"
+ram_lo       = "0x000000B0"
+runtime_base = "0x000000B0"
+dispatch_key = "rom"
+kernel_bless = false
+
+[[recompiler.address_model.copy]]
+name         = "Boot C0 vector"
+rom_lo       = "0x1FC06980"
+rom_hi       = "0x1FC06990"
+ram_lo       = "0x000000C0"
+runtime_base = "0x000000C0"
+dispatch_key = "rom"
+kernel_bless = false
+
